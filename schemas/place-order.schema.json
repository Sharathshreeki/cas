{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "place-order.schema.json",
  "title": "PlaceOrderInput",
  "description": "Input of the placeOrder Server Action (app/actions/orders.ts). Mirrors placeOrderSchema in lib/validation.ts.",
  "type": "object",
  "required": ["stallId", "items", "slotStart", "paymentMethod", "idempotencyKey"],
  "additionalProperties": false,
  "properties": {
    "stallId": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["menuItemId", "quantity", "expectedPrice"],
        "properties": {
          "menuItemId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 10 },
          "expectedPrice": {
            "type": "number",
            "minimum": 0,
            "description": "Price shown to the student; the order is rejected with PRICE_CHANGED if it differs."
          }
        }
      }
    },
    "slotStart": {
      "type": "string",
      "format": "date-time",
      "description": "Start of a 15-minute slot from /api/stalls/{id}/slots."
    },
    "paymentMethod": { "enum": ["CASH_ON_PICKUP", "SIMULATED_ONLINE"] },
    "note": { "type": "string", "maxLength": 200 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 64 },
    "location": {
      "type": ["object", "null"],
      "description": "Only sent when geofencing is enabled. Never stored.",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["lat", "lng"]
    }
  }
}
