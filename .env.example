# PostgreSQL connection string used by Prisma (app + migrations).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cas?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: separate database for integration tests (npm run test:integration).
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cas_test?schema=public"
